{
  "manifest_version": 3,
  "name": "League HQ — Indigo Football League",
  "version": "0.5.2",
  "description": "Commissioner dashboard, playoff-aware historical data collector, weekly newsroom and Frivolities archive for the Indigo Football League.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://all22pokemon.com/*",
    "https://*.public.blob.vercel-storage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open League HQ"
  },
  "content_scripts": [
    {
      "matches": [
        "https://all22pokemon.com/franchise*"
      ],
      "js": [
        "collector-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://all22pokemon.com/franchise*"
      ],
      "js": [
        "collector-main.js",
        "analytics-stats.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
